# Copia a .env.local para desarrollo, o configúralas en Vercel → Settings → Environment Variables.
# Dashboard: https://supabase.com/dashboard/project/_/settings/api

# Públicas (pueden ir en el cliente; la seguridad la dan las políticas RLS en Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional pero recomendado en producción: dominio canónico (OAuth + imagen al compartir en X).
# Ej: https://rai1903web.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Supabase → Authentication → URL Configuration:
#   Site URL: tu dominio público
#   Redirect URLs (añade cada dominio que uses):
#     https://tu-dominio.com/auth/callback
#     http://localhost:3000/auth/callback
# Supabase → Authentication → Providers:
#   Google: Client ID/Secret de Google Cloud Console (OAuth 2.0)
#     Authorized redirect URI en Google: https://<project-ref>.supabase.co/auth/v1/callback
#   X / Twitter (OAuth 2.0): Client ID/Secret de developer.x.com
#     Callback en X: https://<project-ref>.supabase.co/auth/v1/callback

# Solo servidor — NO uses el prefijo NEXT_PUBLIC_. Opcional hasta que haya scripts/admin en el servidor.
# SUPABASE_SERVICE_ROLE_KEY=

# Copia a .env.local para desarrollo, o configúralas en Vercel → Settings → Environment Variables.
# Dashboard: https://supabase.com/dashboard/project/_/settings/api

# Públicas (pueden ir en el cliente; la seguridad la dan las políticas RLS en Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: dominio canónico en producción (OAuth callback en servidor). Ej: https://rai1903.vercel.app
# NEXT_PUBLIC_SITE_URL=

# Supabase → Authentication → URL Configuration:
#   Site URL: tu dominio de Vercel
#   Redirect URLs (añade cada dominio que uses):
#     https://tu-dominio.vercel.app/auth/callback
#     http://localhost:3000/auth/callback
# Supabase → Authentication → Providers → X / Twitter (OAuth 2.0): Client ID/Secret de developer.x.com
#   Callback en X: https://<project-ref>.supabase.co/auth/v1/callback

# Solo servidor — NO uses el prefijo NEXT_PUBLIC_. Opcional hasta que haya scripts/admin en el servidor.
# SUPABASE_SERVICE_ROLE_KEY=

# --- API-Football (solo Edge Functions en Supabase, NUNCA en el cliente) ---
# Configúralas con: supabase secrets set API_FOOTBALL_KEY=... etc.
# API_FOOTBALL_KEY=
# AVILES_TEAM_ID=9632
# SEASON=2025

# Temporada para lectura en Next.js (debe coincidir con SEASON del sync)
# FOOTBALL_SEASON=2025
